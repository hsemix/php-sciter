{
    "name": "hsemix/php-sciter",
    "description": "Native Sciter desktop applications powered by PHP FFI",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-ffi": "*"
    },
    "autoload": {
        "psr-4": {
            "Sciter\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload-dev": {
        "psr-4": {
            "Sciter\\Tests\\": "tests/"
        }
    }
}
